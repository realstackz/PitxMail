{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitxmail",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "pitx.uk/*",
      "zone_name": "pitx.uk",
      "custom_domain": true
    },
    {
      "pattern": "mail.pitx.uk/*",
      "zone_name": "pitx.uk",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pitxmail-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["*@pitx.uk", "*@pitacs.com"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
