{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitxmail",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "9589ea8db135f9eed1a628bebc3c5e71",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "mail.pitx.uk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pitxmail-db",
      "database_id": "4cb028e8-5fa2-4cdf-ab60-4509b71d93fa"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
