{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitxmail",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pitxmail-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true
  }
}
